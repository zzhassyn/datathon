{
  "name": "cashguard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript src/shared/api/openapi.json -o src/shared/api/schema.d.ts",
    "sync:api": "node sync-api.mjs",
    "check:api": "openapi-typescript src/shared/api/openapi.json -o src/shared/api/schema.d.ts --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tanstack/react-query": "5.104.3",
    "openapi-fetch": "0.17.0",
    "lucide-react": "1.59.0",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "openapi-typescript": "7.13.0",
    "@biomejs/biome": "2.5.15",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.10.1"
  }
}
