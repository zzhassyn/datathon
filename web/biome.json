{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!src/shared/api/schema.d.ts",
      "!!src/shared/api/openapi.json",
      "!!pnpm-lock.yaml",
      "!!dist",
      "!!node_modules",
      "!!test-results",
      "!!playwright-report"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useMediaCaption": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
