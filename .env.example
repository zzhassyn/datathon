# Пример настроек CashGuard (pydantic-settings, префикс CG_).
# На Mac рабочий файл: ~/.config/cashguard/.env (chmod 600). В git — только этот пример.

# Ключи API: "principal:token" через запятую. Жюри — jury, команда — team.
CG_API_KEYS=jury:<сгенерировать: uv run just gen-key>,team:<сгенерировать>

# Папки (по умолчанию относительно корня репозитория)
CG_DATA_DIR=var
CG_MODELS_DIR=models
CG_WEB_DIST=web/dist
CG_HOST=127.0.0.1
CG_PORT=8000

# Режим пайплайна: stub | replay | full
CG_PIPELINE_MODE=stub
# Распознавание: coreml | torch | replay | stub | null
CG_VISION_BACKEND=stub
# VLM: mlx | transformers | replay | null
CG_VLM_BACKEND=null
CG_VLM_ENABLED=false
# Квантование Qwen: auto | 8bit | 6bit | 4bit
CG_VLM_QUANT=auto

# Лимиты
CG_MAX_UPLOAD_MB=100
CG_MIN_FREE_MEM_GB=2.5
CG_MIN_FREE_DISK_GB=2
CG_RETENTION_HOURS=24

# Интерфейс: код доступа (пусто — без входа, FAQ 27), Swagger
CG_UI_ACCESS_CODE=
CG_DOCS_ENABLED=true

# Офлайн-режим воркеров (ТЗ §7: без облачных вызовов)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
YOLO_OFFLINE=1
YOLO_AUTOINSTALL=false
