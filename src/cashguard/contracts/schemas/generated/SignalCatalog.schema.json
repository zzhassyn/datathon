        "code": {
          "$ref": "#/$defs/SignalCode"
        },
        "pdf_items": {
          "items": {
            "type": "integer"
          },
          "title": "Pdf Items",
          "type": "array"
        },
        "required_facts": {
          "items": {
            "type": "string"
          },
          "title": "Required Facts",
          "type": "array"
        },
        "template_ru": {
          "minLength": 1,
          "title": "Template Ru",
          "type": "string"
        },
        "title_ru": {
          "minLength": 1,
          "title": "Title Ru",
          "type": "string"
        }
      },
      "required": [
        "code",
        "title_ru",
        "template_ru"
      ],
      "title": "SignalEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "signals": {
      "items": {
        "$ref": "#/$defs/SignalEntry"
      },
      "title": "Signals",
      "type": "array"
    }
  },
  "required": [
    "signals"
  ],
  "title": "SignalCatalog",
  "type": "object"
}
