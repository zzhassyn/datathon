# Окончания строк: скрипты и конфиги всегда LF (bash на macOS не выполняет скрипты с CRLF).
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf

# Двоичные файлы: без преобразования окончаний строк и без текстового diff
*.jpg binary
*.jpeg binary
*.png binary
*.pt binary
*.mlpackage binary
*.mlpackage/** binary

# Добавлено S0 (P0-S0-02): остальные текстовые форматы проекта — тоже LF
justfile text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.plist text eol=lf
*.tmpl text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
uv.lock text eol=lf
pnpm-lock.yaml text eol=lf
*.ps1 text eol=crlf
*.mp4 binary
*.mov binary
*.safetensors binary
